# ==========================================
# TechAxis Global - Careers & Application Config
# ==========================================

# 1. HR Destination Email (Where applications and resumes are sent)
HR_EMAIL=careers@techaxisglobal.com

# 2. Email Sender Identity
SMTP_FROM="TechAxis Global Careers" <careers@techaxisglobal.com>

# 3. SMTP Server Configuration (e.g. Gmail, SendGrid, Outlook, AWS SES)
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-google-app-password
#
# For SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=your-sendgrid-api-key
#
# For Office 365:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-hr-email@company.com
#   SMTP_PASS=your-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# 4. Optional: Google Sheet Webhook Sync (Google Apps Script Webhook URL)
# If provided, all candidate submissions are automatically posted to your Google Sheet
GOOGLE_SHEET_WEBHOOK_URL=
