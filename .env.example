# =========================================================================
# TechAxis Global - Email & Inbound Leads Configuration (.env.example)
# =========================================================================

# Destination Inboxes where consultation inquiries & job applications arrive:
CONTACT_EMAIL="contact@techaxisglobal.com"
HR_EMAIL="contact@techaxisglobal.com"

# -------------------------------------------------------------------------
# OPTION 1: MICROSOFT OFFICE 365 / EXCHANGE SMTP (ACTIVE)
# -------------------------------------------------------------------------
MICROSOFT_SMTP_HOST="smtp.office365.com"
MICROSOFT_SMTP_USER="contact@techaxisglobal.com"
MICROSOFT_SMTP_PASS="your-microsoft-365-password-or-app-password"
MICROSOFT_SMTP_PORT=587

# Standard fallback parameters:
SMTP_HOST="smtp.office365.com"
SMTP_USER="contact@techaxisglobal.com"
SMTP_PASS="your-microsoft-365-password-or-app-password"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="TechAxis Global" <contact@techaxisglobal.com>

# -------------------------------------------------------------------------
# OPTION 2: GOOGLE APPS SCRIPT WEBHOOK (Optional sync to Google Sheets)
# -------------------------------------------------------------------------
GOOGLE_SHEET_WEBHOOK_URL=

# -------------------------------------------------------------------------
# ADMIN CONSOLE AUTHENTICATION & ENCRYPTION GATEWAY
# -------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChooseAStrongAdminPassword2026!"
ADMIN_SESSION_SECRET="generate-a-random-secure-32-char-string-for-hmac"
