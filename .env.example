# =========================================================================
# TechAxis Global - Email & Inbound Leads Configuration (.env.example)
# =========================================================================

# 1. Destination Inboxes (where consultation inquiries & job applications arrive)
HR_EMAIL=techaxisglobal@gmail.com
CONTACT_EMAIL=techaxisglobal@gmail.com

# 2. Email Sender Identity
SMTP_FROM="TechAxis Global" <techaxisglobal@gmail.com>

# -------------------------------------------------------------------------
# OPTION 1: Direct Gmail SMTP (Recommended - 2 Minute Setup)
# -------------------------------------------------------------------------
# Step 1: Visit https://myaccount.google.com/apppasswords
# Step 2: Generate a 16-character App Password for "TAG Website"
# Step 3: Enter your details below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=techaxisglobal@gmail.com
SMTP_PASS=your-16-character-app-password

# -------------------------------------------------------------------------
# OPTION 2: Google Apps Script Webhook (Zero Passwords Needed)
# -------------------------------------------------------------------------
# See google-apps-script.js for setup steps to sync to Google Sheets & auto-email:
GOOGLE_SHEET_WEBHOOK_URL=

